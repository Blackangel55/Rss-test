# Get these from https://my.telegram.org (API development tools)
API_ID=12345678
API_HASH=your_api_hash_here

# Get this from @BotFather on Telegram
BOT_TOKEN=1234567890:your_bot_token_here

# One or more RSS/Atom feed URLs, comma-separated for multiple
RSS_FEED_URL=https://hnrss.org/frontpage

# Channel to post to: @channelusername or numeric id like -1001234567890
# (add the bot as an ADMIN of the channel first)
CHANNEL_ID=@mychannel

# Your numeric Telegram user ID (message @userinfobot to get it).
# Restart notices are sent to your PM instead of the channel.
ADMIN_ID=123456789

# How often to check the feeds, in minutes
CHECK_INTERVAL_MINUTES=15

# Port for the built-in health-check server (Koyeb sets PORT automatically)
PORT=8000
